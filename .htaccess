# Evita que os navegadores guardem em cache as páginas HTML (index.html, privacidade.html
# etc.) — sem isso, uma atualização do site pode não aparecer para quem já visitou antes,
# mesmo depois de reenviar os arquivos, porque o navegador reaproveita a página antiga em
# cache local em vez de buscar a nova no servidor.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Imagens, vídeos, CSS e JS já usam "?v=" no nome para forçar atualização quando o
  # conteúdo muda, então podem ficar em cache por mais tempo sem problema.
  <FilesMatch "\.(css|js|png|webp|jpg|jpeg|svg|ico|mp4|webm|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html

# Desliga a listagem automática de diretório (ex.: alguém acessar /content/ direto
# pelo navegador e ver a lista de arquivos, em vez de dar 403/404).
Options -Indexes

# Cabeçalhos básicos de segurança.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Bloqueia acesso direto via navegador aos arquivos com os hashes de senha do painel,
# ao contador de tentativas de login, e a pastas internas que não deveriam nunca ir
# para o navegador (ex.: .git, se alguém publicar sem usar o zip de entrega).
<FilesMatch "^(auth_data|users|login_attempts)\.json$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.(git|env|htaccess|htpasswd)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS (todo o site já assume https://www.bcontrol.com.br nas meta tags,
  # canonical e dados estruturados). SÓ ATIVAR depois que o SSL do domínio já
  # estiver funcionando — se publicar isso antes do certificado estar ativo, o site
  # fica inacessível (redireciona pra um https que ainda não existe). Se precisar
  # publicar antes do SSL estar pronto, comente as 3 linhas abaixo temporariamente.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^content/\.backups/ - [F,L]
  RewriteRule ^\.git/ - [F,L]
</IfModule>
